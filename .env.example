# Public frontend DSN. The Worker DSN is configured in wrangler.jsonc.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build credentials only. Never use a VITE_ prefix for the authentication token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=my-cloudflare-frontend,my-cloudflare-server
# Set this to your Sentry base URL when using a self-hosted instance.
SENTRY_URL=https://sentry.io/
