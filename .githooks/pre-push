#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
npm run lint
npm test
npm run knip

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$remote_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  files=$(git diff --name-only "$remote_sha" "$local_sha" -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.jsonc')
  [ -z "$files" ] || npx oxfmt --check $files
done
