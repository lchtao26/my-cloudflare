{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-cloudflare",
  "account_id": "9d43af5ca1b5b8bdf48701c030ed2d52",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "secrets": {
    "required": ["NOTION_TOKEN", "INSTAPAPER_CONSUMER_ID", "INSTAPAPER_CONSUMER_SECRET", "INSTAPAPER_OAUTH_TOKEN", "INSTAPAPER_OAUTH_TOKEN_SECRET", "FAVORITE_PIN", "FAVORITE_SESSION_SECRET"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FAVORITE_LOGIN_LIMIT", "class_name": "FavoriteLoginLimit" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FavoriteLoginLimit"] }],
  "d1_databases": [{
    "binding": "HIGHLIGHTS_DB",
    "database_name": "my-cloudflare-highlights",
    "database_id": "9cd174e3-cf5d-4216-8296-43b9d3b20bdf",
    "migrations_dir": "migrations"
  }],
  "keep_vars": true,
  "vars": {
    "NOTION_DATA_SOURCE_ID": "102a59ab-8748-4725-a2f4-48d5ceeef1b6",
    "NOTION_EXCERPTS_DATA_SOURCE_ID": "e800dfdd-d92c-444a-9f28-455e3eae15f6",
    "NOTION_EXCERPTS_VIEW_ID": "40ae75a1-639c-81f8-b7fe-000c40372432",
    "NOTION_EXCERPTS_FAVORITES_VIEW_ID": "40fe75a1-639c-81ae-93c5-000c5971706f"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
